# Copy this file to .env.local and fill in values from your own Supabase
# project (Project Settings → API). Never commit .env.local.

# Public — safe to ship in the client bundle. Access control is enforced by
# Postgres RLS (see supabase/schema.example.sql), not by keeping this secret.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public — the permanent URL that Supabase Auth emails (signup confirmation,
# password reset) always redirect to, regardless of where signup/reset was
# triggered from. Without this, the link defaults to window.location.origin,
# which breaks if that request happened from a local dev server that isn't
# running by the time the email is opened. Must also be added to your
# Supabase project's Auth → URL Configuration → Site URL and Redirect URLs.
VITE_SITE_URL=https://your-deployed-domain.example

# Secret — server-side only. Bypasses RLS entirely. Used by scripts/*.mjs
# (run manually from your own machine) and the ai-assistant edge function
# (set as a Supabase Edge Function secret, not read from this file). Never
# put this in client code or a VITE_-prefixed variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
